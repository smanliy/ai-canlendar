generator client {
  provider = "prisma-client-js"
}

// 数据库数据源配置
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// # User 用户主表
model User {
  id           String    @id @default(uuid()) // 主键，UUID自动生成
  phone        String    @unique //# 手机号 唯一约束，一个手机号只能注册一个账号
  passwordHash String? //密码哈希，可空（短信验证码登录场景不用密码）
  nickname     String
  avatarUrl    String?
  status       String    @default("active") //账号状态：active正常 / disabled封禁
  lastLoginAt  DateTime? //上次登录时间
  createdAt    DateTime  @default(now()) //创建时间
  updatedAt    DateTime  @updatedAt //更新时间
  deletedAt    DateTime?

  refreshTokens RefreshToken[] // 一对多：一个用户可以拥有多个刷新token
  preference    UserPreference? // 一对一：一个用户对应一份偏好设置
  events        CalendarEvent[]
}

// 后端要拿着手机号 + 场景，去库里查到这条记录，做 3 件校验：
// ① 有没有这条记录（有没有获取过验证码）
// ② 当前时间 < 过期时间（没超时）
// ③ 记录里没有 consumedAt（没被核销用过）
// ④ 用户输入的验证码 和 库里存储的一致
// 全部通过才允许登录。
model SmsCode {
  id         String    @id @default(uuid())
  phone      String
  scene      String
  codeHash   String
  expiresAt  DateTime // 验证码过期时间
  consumedAt DateTime? //核销时间；验证通过后赋值，代表已使用
  ipAddress  String? //  用户获取验证码时IP，风控防刷
  userAgent  String? //客户端设备/浏览器信息
  createdAt  DateTime  @default(now())

  //  # 联合索引：根据手机号+场景+过期时间快速查询验证码，提升查询速度
  @@index([phone, scene, expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
}

model UserPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  preferredStartTime     String   @default("19:00")
  preferredEndTime       String   @default("23:00")
  dailyFocusLimitMinutes Int      @default(120)
  avoidWeekends          Boolean  @default(true)
  defaultEventCategory   String   @default("学习")
  defaultReminderMinutes Int      @default(10)
  timezone               String   @default("Asia/Shanghai")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model CalendarEvent {
  id         String    @id @default(uuid())
  userId     String
  title      String
  startTime  DateTime
  endTime    DateTime
  location   String?
  category   String
  priority   String
  note       String?
  status     String    @default("未开始")
  source     String    @default("manual")
  agentRunId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, startTime])
  @@index([userId, endTime])
  @@index([userId, startTime, endTime])
  @@index([agentRunId])
}
